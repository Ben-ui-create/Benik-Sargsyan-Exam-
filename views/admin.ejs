<!DOCTYPE html>
<html>
	<head>
		<title>Admin Panel</title>
	</head>
	<body>
		<h1>Admin Dashboard</h1>

		<form id="filmForm">
			<input
				type="text"
				id="title"
				placeholder="Title"
			/>

			<input
				type="text"
				id="genre"
				placeholder="Genre"
			/>

			<input
				type="number"
				id="duration"
				placeholder="Duration"
			/>

			<textarea
				id="description"
				placeholder="Description"
			></textarea>

			<button type="submit">Add Film</button>
		</form>

		<script>
			document
				.getElementById('filmForm')
				.addEventListener('submit', async e => {
					e.preventDefault()

					await fetch('/films', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({
							title: title.value,
							genre: genre.value,
							duration: duration.value,
							description: description.value
						})
					})

					alert('Film created')
				})
		</script>
	</body>
</html>
